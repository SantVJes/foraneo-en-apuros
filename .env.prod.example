# Copia este archivo como .env.prod y llénalo. NUNCA subas .env.prod a GitHub.
POSTGRES_PASSWORD=pon-una-contrasena-larga
DJANGO_SECRET_KEY=pon-aqui-50-letras-y-numeros-al-azar
# El dominio que le diste al túnel en Cloudflare, por ejemplo api.tudominio.com
DJANGO_ALLOWED_HOSTS=api.tudominio.com
# Dónde vive la web (Cloudflare Pages)
CORS_ALLOWED_ORIGINS=https://foraneo.pages.dev
# Login con Google por Supabase (opcional; vacío = correo y contraseña de Django)
SUPABASE_URL=
PRO_ACTIVO=0
AMAZON_AFILIADOS_TAG=
# Cloudflare > Zero Trust > Networks > Tunnels > Create tunnel > copia el token
CLOUDFLARE_TUNNEL_TOKEN=
