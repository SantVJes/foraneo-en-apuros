# Copia este archivo como .env y cambia los valores
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# En la nube puedes usar una sola URL (Neon, Railway, Render) en lugar de las POSTGRES_*
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

POSTGRES_DB=cartwise
POSTGRES_USER=cartwise
POSTGRES_PASSWORD=cartwise

# Client ID de OAuth de Google (Google Cloud Console > Credenciales)
GOOGLE_CLIENT_ID=

# 1 = cargar platillos, ingredientes y precios de ejemplo al arrancar
CARGAR_DATOS_DEMO=1

# 1 = traer recetas extra de TheMealDB al arrancar (necesita internet)
IMPORTAR_RECETAS=1
LIMITE_RECETAS=40

# 1 = buscar sucursales reales cerca del usuario en OpenStreetMap (necesita internet)
BUSCAR_SUCURSALES_OSM=1

# Dirección pública de tu app (Stripe regresa aquí después de pagar)
APP_URL=http://localhost:8000

# 0 = versión básica, sin Plan Pro ni límite de semanas
PRO_ACTIVO=1

# ---------- Plan Pro con Stripe (dashboard.stripe.com)
# Desarrolladores > Claves de API
STRIPE_SECRET_KEY=
# Desarrolladores > Webhooks > tu endpoint .../api/pro/webhook/ > Secreto de firma
STRIPE_WEBHOOK_SECRET=
# Catálogo de productos > "Cartwise Pro": precio recurrente $19 MXN/mes y precio único $200 MXN
STRIPE_PRECIO_MENSUAL=price_...
STRIPE_PRECIO_ANUAL=price_...

# ---------- Afiliados
# Tu ID de Amazon Afiliados México (termina en -20). Vacío = no se muestra el link de Amazon
AMAZON_AFILIADOS_TAG=

# ---------- Correo para las alertas de ofertas (si no lo pones, se imprimen en la consola)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tu-proveedor.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Cartwise <hola@tudominio.com>

# ---------- Supabase (login de la web) y CORS
SUPABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Login propio de Django y la web vieja en "/". Se apaga solo cuando pones SUPABASE_URL.
# LOGIN_LOCAL=1
# Límites de peticiones por minuto (por IP o por usuario)
# LIMITE_LOGIN=10/min
# LIMITE_ANONIMO=60/min
# LIMITE_USUARIO=300/min
